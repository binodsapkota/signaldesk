<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- MEAI001/MAAI001: approval + workflow APIs are marked experimental in Microsoft.Extensions.AI / Agent Framework -->
    <NoWarn>$(NoWarn);MEAI001;MAAI001;CS1591</NoWarn>
  </PropertyGroup>
</Project>
