# Offline demo mode needs no configuration. To run the agents on a real model,
# copy this file to .env and fill in a key (docker compose reads it automatically).

SIGNALDESK_MODE=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Optional: any OpenAI-compatible endpoint (Azure AI Foundry, Ollama, LM Studio, ...)
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
